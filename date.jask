; jask date implementation

struct Date
    set day = 1
    set month = 1
    set year = 1970
endstruct

; internal restricted variables, so cannot be modified
set secondsPerDay = 86400
restrict secondsPerDay

; internal helper

function _getNumberOfDaysPerMonth(year: number)
    set febDays = 28
    if checkIfYearIsLeapYear(year) set febDays = 29 endif
    return list(31, febDays, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
end

; implementation of functions

function checkIfYearIsLeapYear(year: number) return ((year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)) end

function isValid(date: Date)
    ; sanity checks
    if date->month < 1 or date->month > 12 return false endif
    if date->day < 1   or date->day > 31   return false endif
    if date->year < 1 or date->year > 9999 return false endif

    ; round trip
    set seconds = getElapsedSecondsFromDate(date)
    set reconstructedDate = getDateFromElapsedSeconds(seconds)

    return (date-> year == reconstructedDate->year)
       and (date->month == reconstructedDate->month)
       and (date->day   == reconstructedDate->day)
end

; consumes elapsed seconds since the 01.01.1970
; returns a Date struct
function getDateFromElapsedSeconds(elapsedSeconds: number)
    set totalDays = floor(elapsedSeconds / secondsPerDay)
    set year = 1970

    if totalDays < 0
        while totalDays < 0
            set year = year - 1
            set daysInYear = 365
            if checkIfYearIsLeapYear(year)
                set daysInYear = 366
            endif
            set totalDays = totalDays + daysInYear
        endwhile
    else
        while true
            set daysInYear = 365
            if checkIfYearIsLeapYear(year)
                set daysInYear = 366
            endif
            if totalDays >= daysInYear
                set totalDays = totalDays - daysInYear
                set year = year + 1
            else
                break
            endif
        endwhile
    endif

    set numberOfDaysPerMonth = _getNumberOfDaysPerMonth(year)

    set month = 0
    while totalDays >= listGet(numberOfDaysPerMonth, month)
        set totalDays = totalDays - listGet(numberOfDaysPerMonth, month)
        set month = month + 1
    endwhile

    return Date(year = year, month = month + 1, day = totalDays + 1)
end

; consumes a date
; returns elapsed seconds since the 01.01.1970 from a given date
function getElapsedSecondsFromDate(date: Date)
    set totalDays = 0
    set baseYear = 1970

    set numberOfDaysPerMonth = _getNumberOfDaysPerMonth(date->year)

    if date->year < baseYear
        set runningYear = date->year
        while runningYear < baseYear
            set daysInYear = 365
            if checkIfYearIsLeapYear(runningYear)
                set daysInYear = 366
            endif
            set totalDays = totalDays - daysInYear
            set runningYear = runningYear + 1
        endwhile

        set runningMonth = 1
        while runningMonth < date->month
            set totalDays = totalDays + listGet(numberOfDaysPerMonth, runningMonth - 1)
            set runningMonth = runningMonth + 1
        endwhile

        set totalDays = totalDays + (date->day - 1)

        return totalDays * secondsPerDay
    endif

    set runningYear = baseYear
    while runningYear < date->year
        set daysInYear = 365
        if checkIfYearIsLeapYear(runningYear)
            set daysInYear = 366
        endif
        set totalDays = totalDays + daysInYear
        set runningYear = runningYear + 1
    endwhile

    set runningMonth = 1
    while runningMonth < date->month
        set totalDays = totalDays + listGet(numberOfDaysPerMonth, runningMonth - 1)
        set runningMonth = runningMonth + 1
    endwhile

    set totalDays = totalDays + (date->day - 1)
    
    return totalDays * secondsPerDay
end

function isDateAfter(date1: Date, date2: Date)
    if date1->year > date2->year return true endif
    if date1->year < date2->year return false endif

    if date1->month > date2->month return true endif
    if date1->month < date2->month return false endif

    return date1->day > date2->day
end

function isDateBefore(date1: Date, date2: Date)
    if date1->year < date2->year return true endif
    if date1->year > date2->year return false endif

    if date1->month < date2->month return true endif
    if date1->month > date2->month return false endif

    return date1->day < date2->day
end

function addDays(date: Date, days: number)
    ; sanity check
    if days < 1 return nil endif

    ; convert date to seconds
    set seconds = getElapsedSecondsFromDate(date)

    ; add days as seconds
    set seconds = seconds + days * secondsPerDay

    ; create new date
    return getDateFromElapsedSeconds(seconds)
end

function subtractDays(date: Date, days: number)
    ; sanity check
    if days < 1 return nil endif

    ; convert date to seconds
    set seconds = getElapsedSecondsFromDate(date)

    ; add days as seconds
    set seconds = seconds - days * secondsPerDay

    ; create new date
    return getDateFromElapsedSeconds(seconds)
end

function getDifferenceBetweenDates(date1: Date, date2: Date)
    set date1Seconds = getElapsedSecondsFromDate(date1)
    set date2Seconds = getElapsedSecondsFromDate(date2)

    return date1Seconds - date2Seconds
end

; calculates the day of the week for the input date
; (1 = Monday, 2 = Tuesday, ..., 7 = Sunday)
function getDayOfWeek(date: Date)
    set totalDays = floor(getElapsedSecondsFromDate(date) / secondsPerDay)

    ; since 01.01.1970 was a Thursday (4), offset by +3 before %
    set dayOfWeek = ((totalDays + 3) % 7) + 1
    return dayOfWeek
end

function getDayOfYear(date: Date)
    set numberOfDaysPerMonth = _getNumberOfDaysPerMonth(date->year)

    set dayOfYear = 0
    set currentMonth = 1

    while currentMonth < date->month
        set dayOfYear = dayOfYear + listGet(numberOfDaysPerMonth, currentMonth - 1)
        set currentMonth = currentMonth + 1
    endwhile

    set dayOfYear = dayOfYear + date->day

    return dayOfYear
end

; calculates the ISO 8601 week number for a given date
;;
ISO 8601 defines the first week of a year (Week 1) as the week that contains the first Thursday
of the year (meaning it contains at least 4 days of the new year).
A week always starts on a Monday.
;;
function getWeekOfYear(date: Date)
    set totalDays = floor(getElapsedSecondsFromDate(date) / secondsPerDay)
    set dayOfWeek = getDayOfWeek(date)

    set daysToThursday = 4 - dayOfWeek
    set totalDaysThursday = totalDays + daysToThursday

    set thursdayDate = getDateFromElapsedSeconds(totalDaysThursday * secondsPerDay)
    set weekYear = thursdayDate->year

    set firstJanDate = Date(year = weekYear, month = 1, day = 1)
    set firstJanTotalDays = floor(getElapsedSecondsFromDate(firstJanDate) / secondsPerDay)

    set firstJanDayOfWeek = ((firstJanTotalDays + 3) % 7) + 1

    set firstThursdayTotalDays = firstJanTotalDays + (4 - firstJanDayOfWeek)
    if firstJanDayOfWeek > 4
        set firstThursdayTotalDays = firstThursdayTotalDays + 7
    endif

    return floor((totalDaysThursday - firstThursdayTotalDays) / 7) + 1
end

function getDateFromString(dateStr: string, format: string)
    set yearIdx  = stringGetIndexOf(format, "YYYY")
    set monthIdx = stringGetIndexOf(format, "MM")
    set dayIdx   = stringGetIndexOf(format, "DD")

    if yearIdx == -1 or monthIdx == -1 or dayIdx == -1 return nil endif

    set yearStr  = stringGetSubstring(dateStr, yearIdx, 4)
    set monthStr = stringGetSubstring(dateStr, monthIdx, 2)
    set dayStr   = stringGetSubstring(dateStr, dayIdx, 2)

    set yearVal  = toNumber(yearStr)
    set monthVal = toNumber(monthStr)
    set dayVal   = toNumber(dayStr)

    set parsedDate = Date(year = yearVal, month = monthVal, day = dayVal)

    if not isValid(parsedDate)
        return nil
    endif

    return parsedDate
end

function getStringFromDate(date: Date)
    set dateString = date->year + "-"

    if date->month < 10
        set dateString = dateString + "0"
    endif

    set dateString = dateString + date->month + "-"

    if date->day < 10
        set dateString = dateString + "0"
    endif

   return dateString + date->day
end

function print(date: Date)
    print(stringFromDate(date))
end

function printLine(date: Date)
    print(date)
    print("\n")
end