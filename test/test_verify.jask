printLine("=== verify string ===")
set untrusted = untrust("hello")
set result = verify(untrusted, "string")
assert(result.type == "OK")
assert(result.value == "hello")
printLine("passed")

printLine("=== verify number ===")
set untrusted = untrust("42")
set result = verify(untrusted, "number")
assert(result.type == "OK")
assert(result.value == 42)
set untrusted = untrust("not_a_number")
set result = verify(untrusted, "number")
assert(result.type == "ERR")
printLine("passed")

printLine("=== verify boolean ===")
set untrusted = untrust("true")
set result = verify(untrusted, "boolean")
assert(result.type == "OK")
assert(result.value == true)
set untrusted = untrust("false")
set result = verify(untrusted, "boolean")
assert(result.type == "OK")
assert(result.value == false)
set untrusted = untrust("1")
set result = verify(untrusted, "boolean")
assert(result.type == "OK")
assert(result.value == true)
set untrusted = untrust("0")
set result = verify(untrusted, "boolean")
assert(result.type == "OK")
assert(result.value == false)
set untrusted = untrust("maybe")
set result = verify(untrusted, "boolean")
assert(result.type == "ERR")
printLine("passed")

printLine("=== verify json ===")
set untrusted = untrust("{}")
set result = verify(untrusted, "json")
assert(result.type == "OK")
set untrusted = untrust("[]")
set result = verify(untrusted, "json")
assert(result.type == "OK")
set untrusted = untrust("{\"key\": \"value\"}")
set result = verify(untrusted, "json")
assert(result.type == "OK")
assert(result.value["key"] == "value")
set untrusted = untrust("[1, 2, 3]")
set result = verify(untrusted, "json")
assert(result.type == "OK")
assert(listSize(result.value) == 3)
set untrusted = untrust("not json")
set result = verify(untrusted, "json")
assert(result.type == "ERR")
printLine("passed")

printLine("=== verify email ===")
set untrusted = untrust("user@example.com")
set result = verify(untrusted, "email")
assert(result.type == "OK")
set untrusted = untrust("invalid-email")
set result = verify(untrusted, "email")
assert(result.type == "ERR")
printLine("passed")

printLine("=== trust ===")
set untrusted = untrust("trusted now")
set value = trust(untrusted)
assert(value == "trusted now")
printLine("passed")

printLine("")
printLine("=== ALL VERIFY TESTS PASSED ===")