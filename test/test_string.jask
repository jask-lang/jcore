use "jcore/string" as str

printLine("=== length ===")
assert(str::length("hello") == 5)
assert(str::length("") == 0)
printLine("passed")

printLine("=== toUpper ===")
assert(str::toUpper("hello") == "HELLO")
assert(str::toUpper("Hello World") == "HELLO WORLD")
assert(str::toUpper("HELLO") == "HELLO")
assert(str::toUpper("hello123") == "HELLO123")
printLine("passed")

printLine("=== toLower ===")
assert(str::toLower("HELLO") == "hello")
assert(str::toLower("Hello World") == "hello world")
assert(str::toLower("hello") == "hello")
assert(str::toLower("HELLO123") == "hello123")
printLine("passed")

printLine("=== trim ===")
assert(str::trim("  hello  ") == "hello")
assert(str::trim("hello") == "hello")
assert(str::trim("  hello") == "hello")
assert(str::trim("hello  ") == "hello")
printLine("passed")

printLine("=== trimLeft ===")
assert(str::trimLeft("  hello  ") == "hello  ")
printLine("passed")

printLine("=== trimRight ===")
assert(str::trimRight("  hello  ") == "  hello")
printLine("passed")

printLine("=== split ===")
set parts = str::split("a,b,c", ",")
assert(listSize(parts) == 3)
assert(listGet(parts, 0) == "a")
assert(listGet(parts, 1) == "b")
assert(listGet(parts, 2) == "c")
set words = str::split("hello world foo", " ")
assert(listSize(words) == 3)
assert(listGet(words, 0) == "hello")
printLine("passed")

printLine("=== join ===")
assert(str::join(list("a", "b", "c"), ",") == "a,b,c")
assert(str::join(list("hello", "world"), " ") == "hello world")
assert(str::join(list("x"), ",") == "x")
printLine("passed")

printLine("=== contains ===")
assert(str::contains("hello world", "world") == true)
assert(str::contains("hello world", "xyz") == false)
assert(str::contains("hello", "hello") == true)
printLine("passed")

printLine("=== startsWith ===")
assert(str::startsWith("hello world", "hello") == true)
assert(str::startsWith("hello world", "world") == false)
assert(str::startsWith("hello", "") == true)
printLine("passed")

printLine("=== endsWith ===")
assert(str::endsWith("hello world", "world") == true)
assert(str::endsWith("hello world", "hello") == false)
assert(str::endsWith("hello", "") == true)
printLine("passed")

printLine("=== replace ===")
assert(str::replace("hello world", "world", "jask") == "hello jask")
assert(str::replace("aaa", "a", "bb") == "bbbbbb")
assert(str::replace("hello", "xyz", "abc") == "hello")
printLine("passed")

printLine("=== replaceFirst ===")
assert(str::replaceFirst("hello hello", "hello", "world") == "world hello")
assert(str::replaceFirst("aaa", "a", "bb") == "bbaa")
printLine("passed")

printLine("=== count ===")
assert(str::count("hello hello hello", "hello") == 3)
assert(str::count("aaa", "a") == 3)
assert(str::count("hello", "xyz") == 0)
printLine("passed")

printLine("=== padLeft ===")
assert(str::padLeft("hi", 5, " ") == "   hi")
assert(str::padLeft("hi", 5, "0") == "000hi")
assert(str::padLeft("hello", 3, " ") == "hello")
printLine("passed")

printLine("=== padRight ===")
assert(str::padRight("hi", 5, " ") == "hi   ")
assert(str::padRight("hi", 5, "0") == "hi000")
assert(str::padRight("hello", 3, " ") == "hello")
printLine("passed")

printLine("=== padCenter ===")
assert(str::padCenter("hi", 5, " ") == " hi  ")
assert(str::padCenter("hi", 6, " ") == "  hi  ")
printLine("passed")

printLine("=== repeat ===")
assert(str::repeat("ab", 3) == "ababab")
assert(str::repeat("x", 0) == "")
assert(str::repeat("hello", 1) == "hello")
printLine("passed")

printLine("=== reverse ===")
assert(str::reverse("hello") == "olleh")
assert(str::reverse("abcde") == "edcba")
assert(str::reverse("") == "")
printLine("passed")

printLine("=== isEmpty ===")
assert(str::isEmpty("") == true)
assert(str::isEmpty("hello") == false)
printLine("passed")

printLine("=== isAlpha ===")
assert(str::isAlpha("hello") == true)
assert(str::isAlpha("Hello") == true)
assert(str::isAlpha("hello123") == false)
assert(str::isAlpha("") == false)
printLine("passed")

printLine("=== isNumeric ===")
assert(str::isNumeric("12345") == true)
assert(str::isNumeric("123a") == false)
assert(str::isNumeric("") == false)
printLine("passed")

printLine("=== isAlphanumeric ===")
assert(str::isAlphanumeric("hello123") == true)
assert(str::isAlphanumeric("hello") == true)
assert(str::isAlphanumeric("123") == true)
assert(str::isAlphanumeric("hello world") == false)
assert(str::isAlphanumeric("") == false)
printLine("passed")

printLine("=== isWhitespace ===")
assert(str::isWhitespace("   ") == true)
assert(str::isWhitespace("hello") == false)
assert(str::isWhitespace("") == false)
printLine("passed")

printLine("=== capitalize ===")
assert(str::capitalize("hello") == "Hello")
assert(str::capitalize("HELLO") == "HELLO")
assert(str::capitalize("") == "")
printLine("passed")

printLine("=== titleCase ===")
assert(str::titleCase("hello world") == "Hello World")
assert(str::titleCase("foo bar baz") == "Foo Bar Baz")
printLine("passed")

printLine("=== stringFormat ===")
set fmt = str::stringFormat("Hello {0}, you are {1} years old.", list("Alice", 30))
assert(fmt == "Hello Alice, you are 30 years old.")
printLine("passed")

; ============================================================
; UNICODE TESTS
; ============================================================

printLine("=== length (Unicode) ===")
assert(str::length("café") == 4)
assert(str::length("über") == 4)
assert(str::length("naïve") == 5)
assert(str::length("héllo") == 5)
printLine("passed")

printLine("=== toUpper (Unicode) ===")
assert(str::toUpper("café") == "CAFÉ")
assert(str::toUpper("über") == "ÜBER")
assert(str::toLower("CAFÉ") == "café")
assert(str::toLower("ÜBER") == "über")
assert(str::toUpper("naïve") == "NAÏVE")
assert(str::toLower("NAÏVE") == "naïve")
printLine("passed")

printLine("=== indexOf (Unicode) ===")
assert(str::indexOf("café", "fé") == 2)
assert(str::indexOf("über", "ber") == 1)
assert(str::indexOf("naïve", "ï") == 2)
assert(str::indexOf("café", "xyz") == -1)
printLine("passed")

printLine("=== substring (Unicode) ===")
assert(str::substring("café", 2, 2) == "fé")
assert(str::substring("über", 1, 3) == "ber")
assert(str::substring("naïve", 2, 1) == "ï")
assert(str::substring("héllo", 1, 4) == "éllo")
printLine("passed")

printLine("=== contains (Unicode) ===")
assert(str::contains("café latte", "fé") == true)
assert(str::contains("über alles", "ber") == true)
assert(str::contains("naïve", "ï") == true)
assert(str::contains("café", "xyz") == false)
printLine("passed")

printLine("=== startsWith / endsWith (Unicode) ===")
assert(str::startsWith("café latte", "café") == true)
assert(str::endsWith("café latte", "latte") == true)
assert(str::startsWith("über alles", "über") == true)
assert(str::endsWith("über alles", "alles") == true)
printLine("passed")

printLine("=== replace (Unicode) ===")
assert(str::replace("café café", "café", "tea") == "tea tea")
assert(str::replace("über alles", "über", "unter") == "unter alles")
assert(str::replace("naïve", "ï", "i") == "naive")
printLine("passed")

printLine("=== replaceFirst (Unicode) ===")
assert(str::replaceFirst("café café", "café", "tea") == "tea café")
printLine("passed")

printLine("=== count (Unicode) ===")
assert(str::count("café café café", "café") == 3)
assert(str::count("naïve naïve", "ï") == 2)
assert(str::count("über", "xyz") == 0)
printLine("passed")

printLine("=== split (Unicode) ===")
set parts = str::split("café,über,naïve", ",")
assert(listSize(parts) == 3)
assert(listGet(parts, 0) == "café")
assert(listGet(parts, 1) == "über")
assert(listGet(parts, 2) == "naïve")
printLine("passed")

printLine("=== join (Unicode) ===")
assert(str::join(list("café", "über", "naïve"), " ") == "café über naïve")
printLine("passed")

printLine("=== reverse (Unicode) ===")
assert(str::reverse("café") == "éfac")
assert(str::reverse("über") == "rebü")
printLine("passed")

printLine("=== isAlpha (Unicode) ===")
assert(str::isAlpha("café") == true)
assert(str::isAlpha("über") == true)
assert(str::isAlpha("naïve") == true)
assert(str::isAlpha("héllo") == true)
assert(str::isAlpha("résumé") == true)
assert(str::isAlpha("café123") == false)
printLine("passed")

printLine("=== isAlphanumeric (Unicode) ===")
assert(str::isAlphanumeric("café123") == true)
assert(str::isAlphanumeric("über9000") == true)
assert(str::isAlphanumeric("naïve") == true)
assert(str::isAlphanumeric("café latte") == false)
printLine("passed")

printLine("=== capitalize (Unicode) ===")
assert(str::capitalize("héllo") == "Héllo")
assert(str::capitalize("über") == "Über")
assert(str::capitalize("café") == "Café")
printLine("passed")

printLine("=== titleCase (Unicode) ===")
assert(str::titleCase("café naïve résumé") == "Café Naïve Résumé")
assert(str::titleCase("über alles") == "Über Alles")
printLine("passed")

printLine("=== trim (Unicode) ===")
assert(str::trim("  café  ") == "café")
assert(str::trim("  über  ") == "über")
assert(str::trim("  naïve  ") == "naïve")
printLine("passed")

printLine("=== padLeft / padRight / padCenter (Unicode) ===")
assert(str::padLeft("café", 8, " ") == "    café")
assert(str::padRight("café", 8, " ") == "café    ")
assert(str::padCenter("café", 8, " ") == "  café  ")
printLine("passed")

printLine("=== repeat (Unicode) ===")
assert(str::repeat("café ", 3) == "café café café ")
assert(str::repeat("über", 2) == "überüber")
printLine("passed")

printLine("=== isEmpty (Unicode) ===")
assert(str::isEmpty("") == true)
assert(str::isEmpty("café") == false)
printLine("passed")

printLine("")
printLine("=== ALL STRING MODULE TESTS PASSED ===")
