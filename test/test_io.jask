printLine("=== readFile ===")
set path = "../jcore/test/sample.txt"
set readResult = readFile(path)
assert(readResult.type == "OK")
set result = verify(readResult.value, "string")
assert(result.type == "OK")
assert(result.value == "Hello, World!")
printLine("passed")

printLine("=== writeFile ===")
set writePath = "../jcore/test/writefile_test.txt"
assert(writeFile(writePath, "Hello, World!").type == "OK")
set writeResult = readFile(writePath)
assert(writeResult.type == "OK")
set result = verify(writeResult.value, "string")
assert(result.type == "OK")
assert(result.value == "Hello, World!")
printLine("passed")

printLine("=== writeFile overwrite ===")
assert(writeFile(writePath, "Overwritten content").type == "OK")
set readResult = readFile(writePath)
assert(readResult.type == "OK")
set result = verify(readResult.value, "string")
assert(result.type == "OK")
assert(result.value == "Overwritten content")
printLine("passed")

printLine("=== writeFile empty string ===")
assert(writeFile(writePath, "").type == "OK")
set readResult = readFile(writePath)
assert(readResult.type == "OK")
set empty = verify(readResult.value, "string")
assert(empty.type == "OK")
assert(empty.value == "")
printLine("passed")

printLine("=== writeFile multiline ===")
assert(writeFile(writePath, "Line 1\nLine 2\nLine 3").type == "OK")
set readResult = readFile(writePath)
assert(readResult.type == "OK")
set multi = verify(readResult.value, "string")
assert(multi.type == "OK")
assert(multi.value == "Line 1\nLine 2\nLine 3")
printLine("passed")

printLine("=== fileExists ===")
assert(fileExists("../jcore/test/sample.txt") == true)
assert(fileExists("../jcore/test/nonexistent_file.txt") == false)
printLine("passed")

printLine("")
printLine("=== ALL IO TESTS PASSED ===")