; jask string implementation
; Uses charCode / charFromCode / charToUpper / charToLower for full Unicode support
; Uses charCount / charAt for proper code point iteration

; Returns the length of the string
export function length(s: string)
    return charCount(s)
endfunction

; Returns the index of the first occurrence of substring in s, or -1 if not found
export function indexOf(s: string, substring: string)
    set subLen = length(substring)
    set sLen = length(s)
    if subLen == 0 return 0 endif
    if subLen > sLen return -1 endif

    set i = 0
    while i <= sLen - subLen
        set match = true
        set j = 0
        while j < subLen
            if charAt(s, i + j) != charAt(substring, j)
                set match = false
                break
            endif
            set j = j + 1
        endwhile
        if match
            return i
        endif
        set i = i + 1
    endwhile

    return -1
endfunction

; Returns a substring starting at index with the given length
export function substring(s: string, index: number, length: number)
    set sLen = length(s)
    if index < 0 or index > sLen return "" endif
    if length <= 0 return "" endif
    if index + length > sLen
        set length = sLen - index
    endif

    set result = ""
    set i = 0
    while i < length
        set result = result + charAt(s, index + i)
        set i = i + 1
    endwhile

    return result
endfunction

; Converts the string to uppercase
export function toUpper(s: string)
    set result = ""
    set i = 0
    while i < length(s)
        set result = result + charToUpper(charAt(s, i))
        set i = i + 1
    endwhile
    return result
endfunction

; Converts the string to lowercase
export function toLower(s: string)
    set result = ""
    set i = 0
    while i < length(s)
        set result = result + charToLower(charAt(s, i))
        set i = i + 1
    endwhile
    return result
endfunction

; Removes leading and trailing whitespace
export function trim(s: string)
    return trimRight(trimLeft(s))
endfunction

; Removes leading whitespace
export function trimLeft(s: string)
    set i = 0
    while i < length(s)
        set code = charCode(charAt(s, i))
        if code != 32 and code != 9 and code != 10 and code != 13
            break
        endif
        set i = i + 1
    endwhile
    return substring(s, i, length(s) - i)
endfunction

; Removes trailing whitespace
export function trimRight(s: string)
    set i = length(s) - 1
    while i >= 0
        set code = charCode(charAt(s, i))
        if code != 32 and code != 9 and code != 10 and code != 13
            break
        endif
        set i = i - 1
    endwhile
    return substring(s, 0, i + 1)
endfunction

; Splits the string into a list by delimiter
export function split(s: string, delimiter: string)
    set result = []
    set delimLen = length(delimiter)
    set sLen = length(s)
    set start = 0
    set found = true

    if delimLen == 0
        return list(s)
    endif

    while found
        set remaining = substring(s, start, sLen - start)
        set idx = indexOf(remaining, delimiter)
        if idx == -1
            set result = listAdd(result, remaining)
            set found = false
        else
            set realIdx = start + idx
            set result = listAdd(result, substring(s, start, realIdx - start))
            set start = realIdx + delimLen
        endif
    endwhile

    return result
endfunction

; Joins a list of strings with a delimiter
export function join(list: list, delimiter: string)
    set result = ""
    set i = 0
    while i < listSize(list)
        if i > 0
            set result = result + delimiter
        endif
        set result = result + toString(listGet(list, i))
        set i = i + 1
    endwhile
    return result
endfunction

; Returns true if the string contains the substring
export function contains(s: string, substring: string)
    return indexOf(s, substring) != -1
endfunction

; Returns true if the string starts with the prefix
export function startsWith(s: string, prefix: string)
    set prefixLen = length(prefix)
    if prefixLen > length(s) return false endif
    if prefixLen == 0 return true endif
    return substring(s, 0, prefixLen) == prefix
endfunction

; Returns true if the string ends with the suffix
export function endsWith(s: string, suffix: string)
    set suffixLen = length(suffix)
    set sLen = length(s)
    if suffixLen > sLen return false endif
    if suffixLen == 0 return true endif
    return substring(s, sLen - suffixLen, suffixLen) == suffix
endfunction

; Replaces all occurrences of old with new in the string
export function replace(s: string, old: string, newStr: string)
    set oldLen = length(old)
    if oldLen == 0 return s endif

    set result = ""
    set start = 0
    set sLen = length(s)

    while true
        set remaining = substring(s, start, sLen - start)
        set idx = indexOf(remaining, old)
        if idx == -1
            set result = result + remaining
            break
        endif
        set realIdx = start + idx
        set result = result + substring(s, start, realIdx - start) + newStr
        set start = realIdx + oldLen
    endwhile

    return result
endfunction

; Replaces only the first occurrence of old with new in the string
export function replaceFirst(s: string, old: string, newStr: string)
    set oldLen = length(old)
    if oldLen == 0 return s endif

    set idx = indexOf(s, old)
    if idx == -1 return s endif

    set before = substring(s, 0, idx)
    set afterStart = idx + oldLen
    set after = substring(s, afterStart, length(s) - afterStart)

    return before + newStr + after
endfunction

; Counts the number of occurrences of substring in the string
export function count(s: string, substring: string)
    set subLen = length(substring)
    if subLen == 0 return 0 endif

    set total = 0
    set start = 0
    set sLen = length(s)

    while true
        set remaining = substring(s, start, sLen - start)
        set idx = indexOf(remaining, substring)
        if idx == -1
            break
        endif
        set total = total + 1
        set start = start + idx + subLen
    endwhile

    return total
endfunction

; Pads the string on the left to reach the target width
export function padLeft(s: string, width: number, padChar: string)
    set sLen = length(s)
    if sLen >= width return s endif

    if length(padChar) == 0
        set padChar = " "
    endif

    set needed = width - sLen
    set result = ""
    set i = 0
    while i < needed
        set result = result + padChar
        set i = i + 1
    endwhile

    return result + s
endfunction

; Pads the string on the right to reach the target width
export function padRight(s: string, width: number, padChar: string)
    set sLen = length(s)
    if sLen >= width return s endif

    if length(padChar) == 0
        set padChar = " "
    endif

    set result = s
    set i = 0
    set needed = width - sLen
    while i < needed
        set result = result + padChar
        set i = i + 1
    endwhile

    return result
endfunction

; Centers the string within the target width
export function padCenter(s: string, width: number, padChar: string)
    set sLen = length(s)
    if sLen >= width return s endif

    if length(padChar) == 0
        set padChar = " "
    endif

    set totalPad = width - sLen
    set leftPad = floor(totalPad / 2)
    set rightPad = totalPad - leftPad

    set result = ""
    set i = 0
    while i < leftPad
        set result = result + padChar
        set i = i + 1
    endwhile

    set result = result + s

    set i = 0
    while i < rightPad
        set result = result + padChar
        set i = i + 1
    endwhile

    return result
endfunction

; Repeats the string n times
export function repeat(s: string, n: number)
    set result = ""
    set i = 0
    while i < n
        set result = result + s
        set i = i + 1
    endwhile
    return result
endfunction

; Reverses the string
export function reverse(s: string)
    set result = ""
    set i = length(s) - 1
    while i >= 0
        set result = result + charAt(s, i)
        set i = i - 1
    endwhile
    return result
endfunction

; Checks if the string is empty
export function isEmpty(s: string)
    return length(s) == 0
endfunction

; Checks if the string contains only alphabetic characters (Unicode-aware)
export function isAlpha(s: string)
    if length(s) == 0 return false endif
    set i = 0
    while i < length(s)
        set ch = charAt(s, i)
        if charToUpper(ch) == ch and charToLower(ch) == ch
            return false
        endif
        set i = i + 1
    endwhile
    return true
endfunction

; Checks if the string contains only numeric digits
export function isNumeric(s: string)
    if length(s) == 0 return false endif
    set i = 0
    while i < length(s)
        set code = charCode(charAt(s, i))
        if code < 48 or code > 57
            return false
        endif
        set i = i + 1
    endwhile
    return true
endfunction

; Checks if the string contains only alphanumeric characters
export function isAlphanumeric(s: string)
    if length(s) == 0 return false endif
    set i = 0
    while i < length(s)
        set ch = charAt(s, i)
        set code = charCode(ch)
        ; ASCII digit
        set isDigit = code >= 48 and code <= 57
        ; Unicode letter: charToUpper/charToLower differ from original
        set isLetter = charToUpper(ch) != ch or charToLower(ch) != ch
        if not isDigit and not isLetter
            return false
        endif
        set i = i + 1
    endwhile
    return true
endfunction

; Checks if the string contains only whitespace characters
export function isWhitespace(s: string)
    if length(s) == 0 return false endif
    set i = 0
    while i < length(s)
        set code = charCode(charAt(s, i))
        if code != 32 and code != 9 and code != 10 and code != 13
            return false
        endif
        set i = i + 1
    endwhile
    return true
endfunction

; Capitalizes the first character of the string
export function capitalize(s: string)
    if length(s) == 0 return s endif
    set first = charToUpper(charAt(s, 0))
    return first + substring(s, 1, length(s) - 1)
endfunction

; Capitalizes the first letter of each word in the string
export function titleCase(s: string)
    set result = ""
    set nextIsCapital = true
    set i = 0
    while i < length(s)
        set ch = charAt(s, i)
        if nextIsCapital
            set ch = charToUpper(ch)
        else
            set ch = charToLower(ch)
        endif
        set result = result + ch
        set code = charCode(ch)
        if code == 32 or code == 9 or code == 10 or code == 13
            set nextIsCapital = true
        else
            set nextIsCapital = false
        endif
        set i = i + 1
    endwhile
    return result
endfunction

; Formats a string by replacing placeholders with values
; Example: stringFormat("Hello {0}, you are {1} years old.", list("Alice", 30))
export function stringFormat(template: string, args: list)
    set result = template
    set i = 0
    while i < listSize(args)
        set placeholder = "{" + toString(i) + "}"
        set value = toString(listGet(args, i))
        set result = replace(result, placeholder, value)
        set i = i + 1
    endwhile
    return result
endfunction
